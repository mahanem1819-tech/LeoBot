# Copy this file to ".env" for local development, then fill in real values.
# NEVER commit your actual ".env" file (with real secrets) to GitHub.
#
# On Railway, do NOT upload a .env file — instead, set these same
# variable names in the Railway project's "Variables" tab.

# Your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Your Rubika Bot Token (from @BotFather on Rubika)
RUBIKA_BOT_TOKEN=your_rubika_bot_token_here

# Optional: override the default AI model
DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
