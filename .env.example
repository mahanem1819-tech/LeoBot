# Copy this file to ".env" for local development, then fill in real values.
# NEVER commit your actual ".env" file (with real secrets) to GitHub.
#
# On Railway, do NOT upload a .env file at all — instead, set these same
# variable names in the Railway project's Service -> Variables tab.
# Railway's real environment variables always take priority over ".env"
# even if one happens to exist.

# Your Rubika Bot Token (get one from @BotFather on Rubika). Required.
RUBIKA_BOT_TOKEN=your_rubika_bot_token_here

# Your OpenRouter API key (https://openrouter.ai/keys). Required.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default AI model.
# Defaults to "meta-llama/llama-3.1-8b-instruct" (a free model) if unset.
DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
